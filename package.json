{
  "name": "job-bot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local job hunting bot: fetch jobs for your target countries and remote, filter, score, pick CV version, track applications",
  "scripts": {
    "bot": "node --no-warnings --env-file-if-exists=.env src/cli.ts",
    "web": "npm --prefix web run dev",
    "test": "node scripts/run-tests.mjs",
    "test:web": "npm --prefix web test",
    "test:all": "npm test && npm run test:web",
    "test:db": "node scripts/create-test-db.mjs",
    "typecheck": "tsc -p . && npm --prefix web run typecheck",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:web:coverage": "npm --prefix web run test:coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9"
  }
}
