# Copy to .env and fill in. Only optional settings are listed here.

# Adzuna job search API (https://developer.adzuna.com): register for your own free key.
# Without these the adzuna board is skipped.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# One AI API key, only needed when config.json "ai.provider" is "api" (the default, "claude-cli", uses your
# signed-in Claude Code CLI and needs no key). Paid per token by that provider. Read from here only: never put it
# in config.json. The provider is told from the prefix: sk-ant- Anthropic, gsk_ Groq, sk-or- OpenRouter,
# AIza Gemini, other sk- OpenAI. DeepSeek keys also start with sk-: set "ai.api.preset": "deepseek" for them.
# Mistral, Together and other keys need ai.api.preset too; a local Ollama needs no key.
# AI_API_KEY=
# Optional: any other OpenAI-compatible endpoint (wins over the detected provider).
# AI_BASE_URL=https://example.com/v1
