# Copy to .env and fill in. Only optional settings are listed here.

# Adzuna job search API (https://developer.adzuna.com): register for your own free key.
# Without these the adzuna board is skipped.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# AI provider API keys, only needed when config.json "ai.provider" is "openai" or "deepseek" (the default,
# "claude-cli", uses your signed-in Claude Code CLI and needs no key). These APIs are paid per token.
# The key is read from here only: never put it in config.json.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
