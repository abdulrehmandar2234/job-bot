{
  // Type-check only: Node runs src/ and tests/ directly (type stripping), so nothing is emitted.
  // The dashboard has its own web/tsconfig.json; `npm run typecheck` checks both.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
