{
  "manifest_version": 3,
  "name": "job-bot",
  "version": "0.1.0",
  "description": "Send the job you are looking at to your local job-bot, and copy its prepared letter and answers while you apply.",
  "permissions": ["activeTab", "scripting", "sidePanel", "tabs", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Send to job-bot",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
