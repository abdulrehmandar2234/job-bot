{
  "manifest_version": 3,
  "name": "job-bot",
  "version": "0.2.0",
  "description": "Send the job you are looking at to your local job-bot, and fill its prepared details, letter and answers into application forms. You submit them yourself.",
  "key": "",
  "permissions": ["activeTab", "scripting", "sidePanel", "tabs", "clipboardWrite", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Send to job-bot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
